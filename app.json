{
  "expo": {
    "name": "Azuka",
    "slug": "azuka",
    "version": "0.1.0",
    "scheme": "azuka",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.sento.azuka",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Azuka scans the pairing code shown on your PC.",
        "NSMicrophoneUsageDescription": "Azuka listens while you hold the talk button.",
        "NSFaceIDUsageDescription": "Face ID confirms it is you before Azuka acts on your PC.",
        "NSLocalNetworkUsageDescription": "Azuka talks to the assistant running on your PC over your own network.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryAddUsageDescription": "Azuka saves the clips you pick to your Photos.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      },
      "bitcode": false
    },
    "android": {
      "package": "com.sento.azuka",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/azuka-avatar.png",
          "imageWidth": 180,
          "backgroundColor": "#09080d"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Azuka scans the pairing code shown on your PC."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Azuka listens while you hold the talk button."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID confirms it is you before Azuka acts on your PC."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@config-plugins/react-native-webrtc",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Azuka saves the clips you pick to your Photos."
        }
      ],
      "expo-video",
      "expo-updates"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "url": "https://u.expo.dev/e7947e0b-02c6-4fc4-9e94-71ecbca70a4a"
    },
    "extra": {
      "eas": {
        "projectId": "e7947e0b-02c6-4fc4-9e94-71ecbca70a4a"
      }
    },
    "owner": "senikura"
  }
}
